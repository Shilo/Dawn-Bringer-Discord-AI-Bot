{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Bot",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/bot.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONUNBUFFERED": "1"
            },
            "justMyCode": false,
            "python": "${command:python.interpreterPath}"
        }
    ]
}